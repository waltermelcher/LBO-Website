---
import { Image } from 'astro:assets';
import type { NewsItem } from '../data/news';
import { url } from '../utils';

interface Props { item: NewsItem; delay?: number; featured?: boolean }
const { item, delay = 0, featured = false } = Astro.props;
---

<article class:list={['ncard', 'reveal', featured && 'ncard--featured']} data-delay={String(delay)}>
  <a class="ncard__link" href={url(`/news/${item.slug}`)}>
    <figure class="figure ncard__figure">
      <Image
        src={item.image}
        alt={item.imageAlt}
        widths={[480, 800, 1200]}
        sizes={featured ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
        loading="lazy"
      />
    </figure>
    <div class="ncard__body">
      <p class="ncard__meta">
        <time datetime={item.dateISO}>{item.date}</time>
        <span class="ncard__sep" aria-hidden="true">—</span>
        <span>{item.kicker}</span>
      </p>
      <h3 class="ncard__title">{item.title}</h3>
      <p class="ncard__excerpt">{item.excerpt}</p>
      <span class="ncard__more">
        Weiterlesen
        <svg class="arw" width="15" height="9" viewBox="0 0 16 10" aria-hidden="true">
          <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .ncard__link { display: block; }
  .ncard__figure { aspect-ratio: 16 / 10; margin: 0; }
  .ncard--featured .ncard__figure { aspect-ratio: 16 / 9; }

  .ncard__body { padding-top: 1.5rem; }

  .ncard__meta {
    margin: 0 0 0.9rem;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem;
    font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .ncard__sep { opacity: 0.5; }

  .ncard__title {
    margin: 0;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.55rem);
    font-weight: 300; letter-spacing: -0.022em; line-height: 1.18;
    transition: color .3s var(--ease);
  }
  .ncard--featured .ncard__title { font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.6rem); }

  .ncard__link:hover .ncard__title { color: var(--red); }

  .ncard__excerpt {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ncard--featured .ncard__excerpt { -webkit-line-clamp: 6; line-clamp: 6; font-size: 1.02rem; }

  .ncard__more {
    display: inline-flex; align-items: center; gap: 0.6em;
    margin-top: 1.35rem;
    font-size: 0.74rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--red);
  }
  .ncard__link:hover .arw { transform: translateX(4px); }
  .arw { transition: transform .3s var(--ease); }
</style>
