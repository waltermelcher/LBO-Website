---
/**
 * Optischer Randausgleich.
 *
 * Jeder Buchstabe hat eine Vorbreite – den Abstand zwischen Textkante und dem
 * ersten Strich. Sie wächst mit der Schriftgröße: Ein „H“ bei 50 px beginnt
 * rund 4,9 px hinter der Kante, ein „A“ bei 17 px nur 0,1 px. Überschrift und
 * Fließtext stehen dadurch zwar in derselben Box, sehen aber nicht bündig aus.
 *
 * Dieses Skript misst die tatsächliche Vorbreite des ersten Zeichens je
 * Textblock und gleicht sie über einen negativen Außenabstand aus. Danach
 * beginnt die Schrift aller Blöcke exakt an derselben Kante.
 */
---

<script>
  const SELECTORS = [
    'main h1', 'main h2', 'main h3', 'main h4',
    'main p', 'main li', 'main dt', 'main dd', 'main blockquote',
  ].join(', ');

  const canvas = document.createElement('canvas');
  const ctx = canvas.getContext('2d');

  const firstChar = (el: HTMLElement) => {
    const t = (el.textContent || '').trim();
    return t ? t[0] : '';
  };

  const align = () => {
    if (!ctx) return;
    document.querySelectorAll<HTMLElement>(SELECTORS).forEach((el) => {
      const ch = firstChar(el);
      if (!ch) return;
      const cs = getComputedStyle(el);
      /* zentrierte oder rechtsbündige Blöcke bleiben unangetastet */
      const align = cs.textAlign;
      if (align === 'center' || align === 'right' || align === 'end') return;

      ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      let bearing = 0;
      try {
        bearing = -ctx.measureText(ch).actualBoundingBoxLeft;
      } catch {
        return;
      }
      /* Ausreißer ignorieren – etwa wenn die Messung fehlschlägt */
      if (!Number.isFinite(bearing) || bearing < 0 || bearing > 12) {
        el.style.removeProperty('margin-left');
        return;
      }
      el.style.marginLeft = `${-bearing.toFixed(2)}px`;
    });
  };

  const run = () => requestAnimationFrame(align);

  if (document.fonts && document.fonts.ready) document.fonts.ready.then(run);
  else run();

  let t: number | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(run, 150);
  });
</script>
