---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

import portrait from '../assets/img/bjoern-bus-portrait.jpg';
import dirigentKonzert from '../assets/img/dirigent-konzert.jpg';
import dirigentProbe from '../assets/img/dirigent-probe.jpg';

const formerConductors = [
  { years: '2004 – 2013', name: 'Isabelle Ruf-Weber' },
  { years: '1998 – 2001', name: 'Walter Ratzek' },
  { years: '1997', name: 'Heinz Friesen' },
  { years: '1986 – 1996', name: 'Harry D. Bath' },
  { years: '1980 – 1986', name: 'Alban Nieder' },
  { years: '1978 – 1980', name: 'Prof. Richard Zettler' },
  { years: '1978 – 1984', name: 'Hellmut Haase-Altendorf' },
];

const guestConductors = [
  { years: '2019', name: 'Miguel Echegoncelay' },
  { years: '2013', name: 'Björn Bus' },
  { years: '2012', name: 'Prof. Andreas Kraft' },
  { years: '2010', name: 'Peter Vierneisel' },
  { years: '2003', name: 'Bernhard Volk' },
  { years: '2003', name: 'Wolfgang Wössner' },
  { years: '2002', name: 'Isabelle Ruf-Weber' },
  { years: '2001', name: 'Philipp Kufner' },
  { years: '2001', name: 'Johan de Meij' },
  { years: '1995', name: 'Franco Cesarini' },
];
---

<BaseLayout
  title="Künstlerische Leitung"
  description="Björn Bus ist seit 2014 Künstlerischer Leiter des Landesblasorchesters Baden-Württemberg."
>
  <PageHeader
    title="Künstlerische Leitung"
    lead="Seit 2014 prägt Björn Bus den Klang des Landesblasorchesters."
  />

  <section class="section section--tight">
    <div class="container">
      <div class="bio">
        <figure class="figure bio__portrait reveal">
          <Image src={portrait} alt="Porträt von Björn Bus" widths={[500, 800, 1200]} sizes="(min-width: 900px) 40vw, 100vw" loading="eager" />
        </figure>

        <div class="bio__text reveal" data-delay="1">
          <h2 class="h2 bio__name">Björn Bus</h2>
          <div class="prose">
            <p>
              Björn Bus wurde 1980 in Brunssum, im Süden der Niederlande, geboren, wo seine musikalischen
              Wurzeln tief verankert sind.
            </p>
            <p>
              Im Jahr 2004 schloss er mit Auszeichnung sein Studium in Dirigieren am Konservatorium in
              Groningen mit einem Bachelor-Abschluss ab und studierte dort bei Alex Schillings. Im gleichen
              Jahr widmete er sich auch seinem Studium als Posaunist bei Harrie Ries am Konservatorium in
              Maastricht. 2005 und 2006 vertiefte er seine Studien der Barockposaune bei Wim Becu an der
              Musikhochschule in Aachen. 2010 beendete Björn Bus sein Masterstudium in Dirigieren ebenfalls
              mit Auszeichnung, unter der Leitung des international anerkannten Dirigenten Jan Cober am
              Konservatorium in Maastricht.
            </p>
            <p>
              Seine Ausbildung hörte jedoch nicht dort auf. Er nahm an zahlreichen Meisterkursen teil und
              arbeitete mit renommierten Persönlichkeiten auf diesem Gebiet zusammen. Sein Talent wurde
              schnell anerkannt, und seine Teilnahme an angesehenen Dirigierwettbewerben brachte ihm weitere
              Anerkennung. 2005 belegte er den zweiten Platz beim Wettbewerb der European Brass Band
              Association (EBBA) in Groningen. Beim World Music Contest (WMC) 2009 in Kerkrade gewann er den
              bronzenen Taktstock, während er mit der Marinierskapel der Koninklijke Marine zusammenarbeitete.
            </p>
            <p>
              Derzeit ist Björn Bus als General Artistic Manager des World Music Contest (WMC) in Kerkrade
              tätig. Er dirigiert mehrere Orchester, darunter das Nederlands Douane Orkest und das
              Landesblasorchester Baden-Württemberg. Darüber hinaus ist er Mitglied des Vorstands der WASBE
              (World Association for Symphonic Bands and Ensembles).
            </p>
            <p>
              Björn Bus arbeitet häufig mit prominenten nationalen und internationalen Orchestern zusammen und
              ist ein gefragter Gastdirigent für Ensembles wie die Koninklijke Militaire Kapel „Johan Willem
              Friso“, die Banda Municipal Barcelona, das Bayerische Polizeiorchester und die Ensembles des
              Senzoku Gakuen College of Music in Tokio. Er ist aktiv in der Leitung von Meisterkursen und
              Workshops und wird regelmäßig als Juror bei verschiedenen internationalen Wettbewerben
              eingeladen.
            </p>
            <p>
              Seit 2014 ist Björn Bus Künstlerischer Leiter des Landesblasorchesters Baden-Württemberg.
            </p>
            <p>
              Mehr Informationen auch unter{' '}
              <a href="https://www.bjornbus.nl" target="_blank" rel="noopener noreferrer">www.bjornbus.nl</a>{' '}
              oder auf{' '}
              <a href="https://www.facebook.com/bjornbusconductor/" target="_blank" rel="noopener noreferrer">Björn Bus’ Facebook-Seite</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="imgpair">
        <figure class="figure figure--zoom ratio-3-2 reveal">
          <Image src={dirigentKonzert} alt="Björn Bus dirigiert im Konzert" widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
        <figure class="figure figure--zoom ratio-3-2 reveal" data-delay="1">
          <Image src={dirigentProbe} alt="Björn Bus bei der Probenarbeit" widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container">
      <div class="lists">
        <div>
          <h2 class="h3 lists__head reveal">Ehemalige Dirigenten</h2>
          <ul class="roster reveal">
            {formerConductors.map((c) => (
              <li class="roster__item">
                <span class="roster__years">{c.years}</span>
                <span class="roster__name">{c.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="h3 lists__head reveal" data-delay="1">Gastdirigenten</h2>
          <ul class="roster reveal" data-delay="1">
            {guestConductors.map((c) => (
              <li class="roster__item">
                <span class="roster__years">{c.years}</span>
                <span class="roster__name">{c.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bio { display: grid; gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  @media (min-width: 860px) {
    .bio { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .bio__portrait { position: sticky; top: 120px; }
  }
  .bio__portrait { aspect-ratio: 4 / 5; margin: 0; }
  .bio__name { margin-bottom: 1.6rem; }

  .imgpair { display: grid; gap: clamp(1rem, 2.5vw, 2rem); }
  @media (min-width: 800px) { .imgpair { grid-template-columns: 1fr 1fr; } }

  .lists { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 800px) { .lists { grid-template-columns: 1fr 1fr; } }
  .lists__head { margin-bottom: 1.5rem; }

  .roster { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .roster__item:hover { background: var(--accent-wash); }
  .roster__item {
    display: grid; grid-template-columns: 8.5rem 1fr; align-items: baseline; gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .roster__years { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--ink-3); }
  .roster__name { font-size: 1.05rem; font-weight: 300; letter-spacing: -0.012em; }
</style>
