---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConcertList from '../components/ConcertList.astro';
import NewsCard from '../components/NewsCard.astro';
import Swoosh from '../components/Swoosh.astro';
import SectionHead from '../components/SectionHead.astro';
import { CLAIM, SUBCLAIM } from '../consts';
import { url } from '../utils';
import { NEWS } from '../data/news';
import { PROGRAMME, CONCERTS } from '../data/concerts';

import hero from '../assets/img/hero.jpg';
import orchesterBuehne from '../assets/img/orchester-buehne.jpg';
import dirigent from '../assets/img/dirigent-konzert.jpg';
import wildflowers from '../assets/covers/wildflowers.jpg';
import detailDaempfer from '../assets/img/detail-daempfer.jpg';
import detailEuph from '../assets/img/detail-euphonium.jpg';
import detailKlarinetten from '../assets/img/detail-klarinetten-blau.jpg';
import detailChimes from '../assets/img/detail-chimes.jpg';
import detailTrompeten from '../assets/img/detail-trompeten.jpg';
import detailSaxophon from '../assets/img/detail-saxophon.jpg';
import registerKlarinetten from '../assets/img/register-klarinetten.jpg';
import logoBvbw from '../assets/logos/bvbw.png';
import logoLmv from '../assets/logos/lmv-bw.png';
import logoFreunde from '../assets/logos/freunde-lbo.png';

const gallery = [
  { src: detailDaempfer, alt: 'Dämpfer auf der Bühne, bereitgelegt für den nächsten Satz' },
  { src: detailEuph, alt: 'Euphonium-Solo im Konzert' },
  { src: detailKlarinetten, alt: 'Bassklarinetten im blauen Bühnenlicht' },
  { src: detailChimes, alt: 'Musikerin am Röhrenglockenspiel' },
  { src: detailTrompeten, alt: 'Trompetenregister im Konzert' },
  { src: detailSaxophon, alt: 'Saxophonist beim Spiel' },
];

const facts = [
  { value: '1978', label: 'gegründet als Auswahlorchester des BVBW' },
  { value: '85', label: 'Musikerinnen und Musiker aus ganz Baden-Württemberg' },
  { value: '4', label: 'intensive Probenwochenenden pro Jahr' },
  { value: '96', label: 'Punkte beim WMC 2017 – Vizeweltmeister' },
];

const paths = [
  {
    eyebrow: 'Für Musikerinnen und Musiker',
    title: 'Mitglied werden',
    text: 'In allen Registern lohnt sich ein Probespiel. Die Vorspiele finden im März und im September statt.',
    href: '/mitglied-werden',
  },
  {
    eyebrow: 'Akademie',
    title: 'LBO-hautnah',
    text: 'Ein Wochenende lang das Orchester erleben – zuschauen oder aktiv in den Proben mitspielen.',
    href: '/lbo-hautnah',
  },
  {
    eyebrow: 'Für Musikvereine',
    title: 'Lehrkonzert',
    text: 'Gemeinsam mit dem LBO an einem Klassiker der sinfonischen oder traditionellen Blasmusik arbeiten.',
    href: '/lehrkonzert',
  },
];

const featured = NEWS[0];
---

<BaseLayout overlayHeader description={`${CLAIM} ${SUBCLAIM}`}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__media">
      <Image
        src={hero}
        alt="Das Landesblasorchester Baden-Württemberg im Konzert vor vollem Saal"
        widths={[900, 1400, 2000, 2800]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__inner container">
      <p class="hero__claim">
        <span>Driven by music.</span>
        <span>Connected by heart.</span>
      </p>
      <p class="hero__sub">{SUBCLAIM}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href={url('/konzerttermine')}>
          Konzerttermine
          <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <a class="btn btn--outline-light" href={url('/ueber-uns')}>Das Orchester</a>
      </div>
    </div>

    <a class="hero__cue" href="#konzerte" aria-label="Weiter zu den Konzerten">
      <span>Scrollen</span>
      <svg width="12" height="26" viewBox="0 0 12 26" aria-hidden="true">
        <path d="M6 0v22M1 17l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.1" />
      </svg>
    </a>
  </section>

  <!-- ============ NÄCHSTE KONZERTE ============ -->
  <section class="section section--tight" id="konzerte">
    <div class="container">
      <SectionHead title="Nächste Konzerte">
        <a slot="action" class="link" href={url('/konzerttermine')}>
          Alle Termine
          <svg class="arw" width="15" height="9" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </SectionHead>
      <ConcertList limit={4} compact />
    </div>
  </section>

  <!-- ============ POSITIONIERUNG ============ -->
  <section class="section section--deep">
    <div class="container">
      <SectionHead
        size="md"
        eyebrow="Das Orchester"
        title="Das Auswahlorchester des Blasmusikverbandes Baden-Württemberg – seit 1978 der Klangkörper des Landes."
      />
      <div class="sbody">
        <div>
          <div class="intro__grid">
            <div class="prose reveal" data-delay="1">
              <p>
                Rund 85 hochqualifizierte Musikerinnen und Musiker aus allen Musikvereinen des Landes kommen
                viermal im Jahr zusammen, um in intensiven Probenwochenenden ein Konzertprogramm zu erarbeiten.
                Das Repertoire umfasst Originalkompositionen und Bearbeitungen klassischer Werke, Uraufführungen
                und kammermusikalische Besetzungen.
              </p>
              <p>
                Zahlreiche internationale Preise, Referenzen und CD-Produktionen dokumentieren die besondere
                Qualität des Landesblasorchesters – zuletzt der Titel des Vizeweltmeisters beim World Music
                Contest in Kerkrade.
              </p>
              <p><a class="link" href={url('/ueber-uns')}>Über uns
                <svg class="arw" width="15" height="9" viewBox="0 0 16 10" aria-hidden="true">
                  <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg></a></p>
            </div>
            <figure class="figure figure--zoom ratio-4-5 reveal" data-delay="2">
              <Image src={orchesterBuehne} alt="Das Landesblasorchester auf der Bühne" widths={[500, 900, 1400]} sizes="(min-width: 900px) 38vw, 100vw" loading="lazy" />
            </figure>
          </div>

          <dl class="facts">
            {facts.map((f, i) => (
              <div class="facts__item reveal" data-delay={String(i)}>
                <dt class="facts__value">{f.value}</dt>
                <dd class="facts__label">{f.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AUFMACHER ECWO ============ -->
  <section class="section feature">
    <div class="container">
      <div class="split split--even feature__grid">
        <div class="feature__text reveal">
          <span class="eyebrow">Im Fokus · 22. November 2026</span>
          <h2 class="h2">Heimspiel bei der Europameisterschaft</h2>
          <div class="prose">
            <p>
              Im Rahmen der BRAWO-Messe wird die Europameisterschaft für sinfonische Blasorchester (ECWO)
              erstmals in Deutschland ausgetragen – in Stuttgart. Das Landesblasorchester vertritt dabei
              Deutschland.
            </p>
            <p>
              Das gesamte zweite Halbjahr steht im Zeichen des Wettbewerbs: mehr Probenzeit für jedes einzelne
              Werk, mehr Raum für Details, mit dem klaren Ziel, das bestmögliche Ergebnis zu erarbeiten.
            </p>
          </div>
          <div class="feature__actions">
            <a class="btn" href={url('/news/das-lbo-vertritt-deutschland-beim-ecwo-2026')}>
              Zur Meldung
              <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
              </svg>
            </a>
            <a class="btn btn--ghost" href={url('/programm')}>Wettbewerbsprogramm</a>
          </div>
        </div>

        <figure class="figure figure--zoom feature__figure reveal" data-delay="1">
          <Image src={featured.image} alt={featured.imageAlt} widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <Swoosh class="divider" />

  <!-- ============ PROGRAMM ============ -->
  <section class="section section--tight">
    <div class="container">
      <SectionHead
        eyebrow="Konzertprogramm"
        title={PROGRAMME.season}
        lead="Drei Werke, die das Orchester in dieser Saison durch die Konzerte und zur Europameisterschaft begleiten."
      />
      <div class="sbody">
        <div>
          <ol class="prog">
            {PROGRAMME.works.map((w, i) => (
              <li class="prog__item reveal" data-delay={String(i)}>
                <span class="prog__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="prog__work">
                  <span class="prog__title">{w.title}</span>
                  <span class="prog__composer">{w.composer} <span class="prog__life">({w.life})</span></span>
                </span>
                <span class="prog__year">{w.year}</span>
              </li>
            ))}
          </ol>
          <p class="prog__more reveal">
            <a class="link" href={url('/programm')}>Zum Programm
              <svg class="arw" width="15" height="9" viewBox="0 0 16 10" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ KÜNSTLERISCHE LEITUNG ============ -->
  <section class="section section--dark conductor">
    <div class="container">
      <div class="split split--even conductor__grid">
        <figure class="figure figure--zoom conductor__figure reveal">
          <Image src={dirigent} alt="Björn Bus dirigiert das Landesblasorchester" widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
        <div class="conductor__text reveal" data-delay="1">
          <span class="eyebrow">Künstlerische Leitung</span>
          <h2 class="h2">Björn Bus</h2>
          <p class="lead">
            Seit 2014 prägt der Niederländer Björn Bus den Klang des Landesblasorchesters – als General
            Artistic Manager des World Music Contest in Kerkrade und Vorstandsmitglied der WASBE ist er
            international eine der prägenden Stimmen der sinfonischen Blasmusik.
          </p>
          <a class="btn btn--light" href={url('/kuenstlerische-leitung')}>
            Zur Künstlerischen Leitung
            <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
              <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AKTUELLES ============ -->
  <section class="section">
    <div class="container">
      <SectionHead title="Aktuelles">
        <a slot="action" class="link" href={url('/news')}>
          Alle Meldungen
          <svg class="arw" width="15" height="9" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </SectionHead>
      <div class="news-grid">
        {NEWS.map((item, i) => <NewsCard item={item} delay={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ HÖREN ============ -->
  <section class="section section--deep">
    <div class="container">
      <div class="split split--even listen">
        <div class="listen__text reveal">
          <span class="eyebrow">Hören</span>
          <h2 class="h2">Wildflowers – zu Hause erleben</h2>
          <div class="prose">
            <p>
              Anlässlich der großen Konzertreise nach Südkorea zur WASBE-Konferenz wurde das Programm
              „Wildflowers“ in der Stadthalle Göppingen professionell aufgenommen – ein Blumenstrauß junger
              Werke aus ganz Europa.
            </p>
          </div>
          <div class="listen__actions">
            <a class="btn" href="https://www.youtube.com/user/landesblasorchester" target="_blank" rel="noopener noreferrer">
              Wildflowers erleben
              <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
              </svg>
            </a>
            <a class="btn btn--ghost" href={url('/cds')}>Alle CDs und DVDs</a>
          </div>
        </div>
        <figure class="figure listen__cover reveal" data-delay="1">
          <Image src={wildflowers} alt="Cover der LP Wildflowers" widths={[400, 700, 900]} sizes="(min-width: 900px) 42vw, 100vw" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ BILDSTRECKE ============ -->
  <section class="section section--tight gal">
    <div class="container">
      <SectionHead
        title="Nah dran"
        lead="Die Musiker und ihre Instrumente – das Herzstück des Orchesters."
      />
      <div class="gal__grid">
        {gallery.map((g, i) => (
          <figure class="figure figure--zoom gal__item reveal" data-delay={String(Math.min(i % 3, 4))}>
            <Image
              src={g.src}
              alt={g.alt}
              widths={[420, 700, 1000]}
              sizes="(min-width: 1000px) 32vw, (min-width: 600px) 48vw, 92vw"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MITMACHEN ============ -->
  <section class="section paths">
    <div class="container">
      <SectionHead eyebrow="Mitmachen" title="Drei Wege ins Landesblasorchester" />
      <div class="paths__grid">
        {paths.map((p, i) => (
          <a class="pathcard reveal" data-delay={String(i)} href={url(p.href)}>
            <span class="pathcard__eyebrow">{p.eyebrow}</span>
            <h3 class="pathcard__title">{p.title}</h3>
            <p class="pathcard__text">{p.text}</p>
            <span class="pathcard__more">
              Mehr erfahren
              <svg class="arw" width="15" height="9" viewBox="0 0 16 10" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FÖRDERN ============ -->
  <section class="section section--dark support">
    <div class="container">
      <div class="split split--even support__grid">
        <div class="reveal">
          <span class="eyebrow">Förderverein</span>
          <h2 class="h2">Freunde des Landesblasorchesters</h2>
          <p class="lead">
            Ehemalige und aktive Musiker, Konzertbesucher, Freunde und Gönner unterstützen die kulturelle
            Arbeit des LBO und die Weiterentwicklung des Kulturgutes sinfonische Blasmusik – ideell und
            materiell.
          </p>
          <a class="btn btn--light" href={url('/foerderverein')}>
            Förderverein
            <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
              <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
        <figure class="figure figure--zoom support__figure reveal" data-delay="1">
          <Image src={registerKlarinetten} alt="Klarinettenregister des Landesblasorchesters" widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ FÖRDERER ============ -->
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow eyebrow--muted text-center funders__head">Gefördert von</p>
      <div class="funders reveal">
        <Image class="funders__logo funders__logo--wide" src={logoBvbw} alt="Blasmusikverband Baden-Württemberg" widths={[240, 480]} sizes="220px" loading="lazy" />
        <Image class="funders__logo funders__logo--tall" src={logoLmv} alt="Landesmusikverband Baden-Württemberg e.V." widths={[200, 400]} sizes="120px" loading="lazy" />
        <Image class="funders__logo" src={logoFreunde} alt="Freunde des Landesblasorchesters Baden-Württemberg" widths={[240, 480]} sizes="200px" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section class="section cta">
    <div class="container">
      <div class="cta__box reveal">
        <div>
          <span class="eyebrow">Kontakt</span>
          <h2 class="h2 cta__title">Ob Galakonzert, Mitgliedschaft oder Lehrangebot – sprechen Sie uns an.</h2>
        </div>
        <a class="btn" href={url('/kontakt')}>
          Kontakt aufnehmen
          <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #100e0b;
    color: #fff;
  }
  .hero__media { position: absolute; inset: 0; }
  .hero__media :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center 42%;
    animation: heroZoom 26s var(--ease) forwards;
  }
  @keyframes heroZoom {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img) { animation: none; }
  }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(16,14,11,.92) 0%, rgba(16,14,11,.78) 26%, rgba(16,14,11,.42) 52%, rgba(16,14,11,.14) 74%, rgba(16,14,11,.46) 100%),
      linear-gradient(to right, rgba(16,14,11,.55) 0%, rgba(16,14,11,.18) 46%, rgba(16,14,11,0) 72%);
  }

  .hero__inner {
    position: relative;
    padding-bottom: clamp(6rem, 14vh, 10rem);
    padding-top: 10rem;
  }

  .hero__claim {
    margin: 0;
    font-size: clamp(2.6rem, 1rem + 7.2vw, 6.4rem);
    font-weight: 250;
    line-height: 0.99;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .hero__claim span {
    display: block;
    opacity: 0;
    transform: translateY(22px);
    animation: heroIn 1s var(--ease) forwards;
  }
  .hero__claim span:nth-child(1) { animation-delay: .15s; }
  .hero__claim span:nth-child(2) { animation-delay: .3s; }

  .hero__sub {
    margin: 1.6rem 0 0;
    font-size: clamp(1rem, 0.92rem + 0.5vw, 1.28rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.88);
    max-width: 52ch;
    opacity: 0; transform: translateY(16px);
    animation: heroIn .9s var(--ease) .48s forwards;
  }

  .hero__actions {
    display: flex; flex-wrap: wrap; gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    opacity: 0; transform: translateY(16px);
    animation: heroIn .9s var(--ease) .62s forwards;
  }

  @keyframes heroIn { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__claim span, .hero__sub, .hero__actions { opacity: 1; transform: none; animation: none; }
  }

  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 5vh, 3.5rem);
    display: none;
    flex-direction: column; align-items: center; gap: 0.85rem;
    font-size: 0.66rem; font-weight: 600;
    letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--red-light);
    writing-mode: vertical-rl;
    transition: color .3s var(--ease);
  }
  .hero__cue svg { writing-mode: horizontal-tb; animation: cue 2.6s var(--ease) infinite; }
  .hero__cue:hover { color: #f0d8dd; }
  @keyframes cue { 0%,100% { transform: translateY(0); opacity: .6 } 50% { transform: translateY(5px); opacity: 1 } }
  @media (min-width: 1060px) { .hero__cue { display: flex; } }


  /* ---------------- Positionierung ---------------- */
  .intro__grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); margin-top: clamp(2rem, 4vw, 3rem); }
  .intro__grid .prose { max-width: none; }
  @media (min-width: 780px) {
    .intro__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: clamp(2.75rem, 5vw, 4rem) 0 0;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .facts__item { margin: 0; }
  .facts__value {
    font-size: clamp(2.1rem, 1.4rem + 2.4vw, 3.4rem);
    font-weight: 250; letter-spacing: -0.04em; line-height: 1;
    color: var(--red);
  }
  .facts__label {
    margin: 0.75rem 0 0;
    font-size: 0.86rem; line-height: 1.45;
    color: var(--ink-2);
    max-width: 22ch;
  }

  /* ---------------- Feature ---------------- */
  .feature__grid { align-items: center; }
  .feature__text .prose { margin-top: 1.5rem; }
  .feature__figure { aspect-ratio: 16 / 10; }
  .feature__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  @media (min-width: 900px) {
    .feature__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }

  .divider { margin-block: clamp(1rem, 3vw, 2.5rem); }

  /* ---------------- Programm ---------------- */
  .prog { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .prog__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: clamp(1.1rem, 2.2vw, 1.7rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .prog__num {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em;
    color: var(--red-light);
  }
  .prog__work { display: block; }
  .prog__title {
    display: block;
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.85rem);
