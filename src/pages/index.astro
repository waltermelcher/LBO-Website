---
/**
 * Startseite.
 *
 * Kopf: Vollbild-Foto mit Claim und transparenter Navigation.
 * Darunter die Formensprache der LBO-Druckmedien (CD Manual, Plakate S. 37/39,
 * Programmheft S. 53): Tourneeliste mit großen Tageszahlen, Programm auf einer
 * Fläche in LBO-Rot dunkel, Fotos im Anschnitt bis zum Bildschirmrand und eine
 * Wellenkante mit Freihandlinien als Abschluss vor dem Kontakt.
 *
 * - nur CD-Farben (Beige, drei LBO-Rottöne, Weiß; Petrol nur beim Förderverein)
 * - Überschriften Semibold, Fließtext Light – so schreibt es das Manual vor
 * - Fotos unverändert, Newsbanner unbeschnitten
 */
import { Image } from 'astro:assets';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import PhotoSlider from '../components/PhotoSlider.astro';
import { CLAIM, SUBCLAIM } from '../consts';
import { url } from '../utils';
import { NEWS } from '../data/news';
import { PROGRAMME, CONCERTS } from '../data/concerts';

import hero from '../assets/img/hero.jpg';
import orchesterBuehne from '../assets/img/orchester-buehne.jpg';
import dirigent from '../assets/img/dirigent-konzert.jpg';
import wildflowers from '../assets/covers/wildflowers.jpg';
import detailKontrabass from '../assets/img/detail-kontrabassklarinette.jpg';
import detailEuph from '../assets/img/detail-euphonium.jpg';
import detailKlarinetten from '../assets/img/detail-klarinetten-blau.jpg';
import detailChimes from '../assets/img/detail-chimes.jpg';
import registerTrompeten from '../assets/img/register-trompeten.jpg';
import detailSaxophon from '../assets/img/detail-saxophon.jpg';
import detailFagott from '../assets/img/detail-fagott.jpg';
import detailPosaunen from '../assets/img/detail-posaunen.jpg';
import detailBecken from '../assets/img/detail-becken.jpg';
import detailTuben from '../assets/img/detail-tuben.jpg';
import registerKlarinetten from '../assets/img/register-klarinetten.jpg';
import logoBvbw from '../assets/logos/bvbw.png';
import logoLmv from '../assets/logos/lmv-bw.png';
import logoFreunde from '../assets/logos/freunde-lbo.png';

const gallery = [
  { src: detailKontrabass, alt: 'Musiker an der Kontrabassklarinette' },
  { src: detailEuph, alt: 'Euphonium-Solo im Konzert' },
  { src: detailKlarinetten, alt: 'Bassklarinetten im blauen Bühnenlicht' },
  { src: detailChimes, alt: 'Musikerin am Röhrenglockenspiel' },
  { src: registerTrompeten, alt: 'Zwei Trompeter des Landesblasorchesters' },
  { src: detailSaxophon, alt: 'Saxophonist beim Spiel' },
  { src: detailFagott, alt: 'Fagotte im Holzbläserregister' },
  { src: detailPosaunen, alt: 'Posaunenregister im Konzert' },
  { src: detailBecken, alt: 'Schlagwerk mit Gong und Becken' },
  { src: detailTuben, alt: 'Tubenschalltrichter im Orchester' },
];

const paths = [
  {
    title: 'Mitglied werden',
    text: 'Für Musikerinnen und Musiker: In allen Registern lohnt sich ein Probespiel. Die Vorspiele finden im März und im September statt.',
    href: '/mitglied-werden',
  },
  {
    title: 'Die Akademie LBO-hautnah',
    text: 'Ein Wochenende lang das Orchester erleben – zuschauen oder aktiv in den Proben mitspielen.',
    href: '/lbo-hautnah',
  },
  {
    title: 'Lehrkonzert',
    text: 'Für Musikvereine: Gemeinsam mit dem LBO an einem Klassiker der sinfonischen oder traditionellen Blasmusik arbeiten.',
    href: '/lehrkonzert',
  },
];

/* „11. Oktober 2026“ → Tag und Monat getrennt setzen */
const concerts = CONCERTS.map((c) => {
  const [day, ...rest] = c.date.split(' ');
  return { ...c, day: day.replace('.', ''), month: rest.join(' ') };
});

const featured = NEWS[0];
---

<BaseLayout overlayHeader description={`${CLAIM} ${SUBCLAIM}`}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__media">
      <Image
        src={hero}
        alt="Das Landesblasorchester Baden-Württemberg im Konzert vor vollem Saal"
        widths={[900, 1400, 2000, 2800]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__inner container">
      <h1 class="hero__claim">
        <span>Driven by music.</span>
        <span>Connected by heart.</span>
      </h1>
      <p class="hero__sub">{SUBCLAIM}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href={url('/konzerttermine')}>
          Konzerttermine
          <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <a class="btn btn--outline-light" href={url('/ueber-uns')}>Das Orchester</a>
      </div>
    </div>

  </section>

  <!-- ============ KONZERTE ============ -->
  <section class="section" id="konzerte">
    <div class="container">
      <h2 class="fr-h2">Nächste Konzerte</h2>

      <ol class="dates">
        {concerts.map((c) => (
          <li class="dates__item">
            <p class="dates__when">
              <time datetime={c.dateISO}>
                <span class="dates__day">{c.day}</span>
                <span class="dates__month">{c.month}</span>
              </time>
              <span class="dates__weekday">{c.weekday}</span>
            </p>
            <h3 class="dates__place">{c.place}</h3>
            {c.title && <p class="dates__title">{c.title}</p>}
            {c.details && (
              <ul class="dates__details">
                {c.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>

      <div class="fr-actions">
        <a class="btn" href={url('/konzerttermine')}>Alle Termine</a>
        <a class="btn btn--ghost" href={url('/programm')}>Programm</a>
      </div>
    </div>
  </section>

  <!-- ============ AUFMACHER ECWO ============ -->
  <section class="section section--deep">
    <div class="container ecwo">
      <div class="ecwo__text">
        <h2 class="fr-h2">Heimspiel bei der Europameisterschaft in Stuttgart</h2>
        <p class="fr-text">
          Am 22. November 2026 wird die Europameisterschaft für sinfonische Blasorchester (ECWO) im
          Rahmen der BRAWO-Messe erstmals in Deutschland ausgetragen. Das Landesblasorchester vertritt
          dabei Deutschland.
        </p>
        <p class="fr-text">
          Das gesamte zweite Halbjahr steht im Zeichen des Wettbewerbs: mehr Probenzeit für jedes einzelne
          Werk, mehr Raum für Details, mit dem klaren Ziel, das bestmögliche Ergebnis zu erarbeiten.
        </p>
        <div class="fr-actions">
          <a class="btn" href={url('/news/das-lbo-vertritt-deutschland-beim-ecwo-2026')}>Zur Meldung</a>
          <a class="btn btn--ghost" href={url('/programm')}>Wettbewerbsprogramm</a>
        </div>
      </div>
      <figure class="ecwo__banner">
        <Image src={featured.image} alt={featured.imageAlt} widths={[600, 1000, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ============ ORCHESTER ============ -->
  <section class="section">
    <div class="container bleed bleed--right">
      <div class="bleed__text">
        <h2 class="fr-h2 fr-h2--statement">
          Das Auswahlorchester des Blasmusikverbandes Baden-Württemberg – seit 1978 der Klangkörper des Landes.
        </h2>
        <p class="fr-text">
          Rund 85 hochqualifizierte Musikerinnen und Musiker aus allen Musikvereinen des Landes kommen
          viermal im Jahr zusammen, um in intensiven Probenwochenenden ein Konzertprogramm zu erarbeiten.
          Das Repertoire umfasst Originalkompositionen und Bearbeitungen klassischer Werke, Uraufführungen
          und kammermusikalische Besetzungen.
        </p>
        <p class="fr-text">
          Zahlreiche internationale Preise, Referenzen und CD-Produktionen dokumentieren die besondere
          Qualität des Landesblasorchesters – zuletzt der Titel des Vizeweltmeisters beim World Music
          Contest in Kerkrade.
        </p>
        <a class="fr-link" href={url('/ueber-uns')}>Über uns</a>
      </div>
      <figure class="bleed__photo">
        <Image src={orchesterBuehne} alt="Das Landesblasorchester auf der Bühne" widths={[700, 1100, 1600, 2200]} sizes="(min-width: 900px) 58vw, 100vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ============ PROGRAMM (Programmheft) ============ -->
  <section class="red">
    <svg class="red__lines" viewBox="0 0 1600 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <path d="M-60 170C180 170 290 36 540 36c260 0 330 140 600 140 220 0 300-86 520-86" />
      <path d="M-60 100c250 0 340 86 600 86 240 0 320-150 560-150 230 0 300 118 560 118" />
    </svg>
    <div class="container red__inner">
      <div class="red__head">
        <h2 class="fr-h2">{PROGRAMME.season}</h2>
        <p class="fr-text">
          Drei Werke, die das Orchester in dieser Saison durch die Konzerte und zur Europameisterschaft begleiten.
        </p>
      </div>
      <ol class="works">
        {PROGRAMME.works.map((w) => (
          <li class="works__item">
            <p class="works__title">{w.title}</p>
            <p class="works__by">
              {w.composer} ({w.life}), {w.year}
            </p>
          </li>
        ))}
      </ol>
      <div class="fr-actions">
        <a class="btn btn--paper" href={url('/programm')}>Zum Programm</a>
      </div>
    </div>
  </section>

  <!-- ============ KÜNSTLERISCHE LEITUNG ============ -->
  <section class="section">
    <div class="container bleed bleed--left">
      <figure class="bleed__photo">
        <Image src={dirigent} alt="Björn Bus dirigiert das Landesblasorchester" widths={[700, 1100, 1600, 2000]} sizes="(min-width: 900px) 58vw, 100vw" loading="lazy" />
      </figure>
      <div class="bleed__text">
        <h2 class="fr-h2">Björn Bus – künstlerische Leitung</h2>
        <p class="fr-text fr-text--lead">
          Seit 2014 prägt der Niederländer Björn Bus den Klang des Landesblasorchesters – als General
          Artistic Manager des World Music Contest in Kerkrade und Vorstandsmitglied der WASBE ist er
          international eine der prägenden Stimmen der sinfonischen Blasmusik.
        </p>
        <a class="btn btn--ghost" href={url('/kuenstlerische-leitung')}>Zur Künstlerischen Leitung</a>
      </div>
    </div>
  </section>

  <!-- ============ AKTUELLES ============ -->
  <section class="section section--deep news">
    <div class="container">
      <div class="fr-head">
        <h2 class="fr-h2">Aktuelles</h2>
        <a class="fr-link" href={url('/news')}>Alle Meldungen</a>
      </div>
      <div class="news__grid">
        {NEWS.map((item, i) => <NewsCard item={item} delay={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ HÖREN ============ -->
  <section class="section">
    <div class="container listen">
      <figure class="listen__cover">
        <Image src={wildflowers} alt="Cover der LP Wildflowers" widths={[400, 700, 900]} sizes="(min-width: 900px) 36vw, 100vw" loading="lazy" />
      </figure>
      <div class="listen__text">
        <h2 class="fr-h2">Wildflowers – zu Hause erleben</h2>
        <p class="fr-text">
          Anlässlich der großen Konzertreise nach Südkorea zur WASBE-Konferenz wurde das Programm
          „Wildflowers“ in der Stadthalle Göppingen professionell aufgenommen – ein Blumenstrauß junger
          Werke aus ganz Europa.
        </p>
        <div class="fr-actions">
          <a class="btn" href="https://www.youtube.com/user/landesblasorchester" target="_blank" rel="noopener noreferrer">Wildflowers erleben</a>
          <a class="btn btn--ghost" href={url('/cds')}>Alle CDs und DVDs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NAH DRAN ============ -->
  <section class="section section--deep near">
    <div class="container">
      <div class="fr-head">
        <h2 class="fr-h2">Nah dran</h2>
        <p class="fr-text">Die Musiker und ihre Instrumente – das Herzstück des Orchesters.</p>
      </div>
    </div>
    <PhotoSlider items={gallery} interval={5000} label="Nahaufnahmen aus dem Orchester" />
  </section>

  <!-- ============ MITMACHEN ============ -->
  <section class="section">
    <div class="container">
      <h2 class="fr-h2">Im LBO musizieren</h2>
      <ul class="paths">
        {paths.map((p) => (
          <li class="paths__item">
            <h3 class="paths__title">
              <a href={url(p.href)}>{p.title}</a>
            </h3>
            <p class="paths__text">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ FÖRDERN ============ -->
  <section class="section section--dark theme-blue support">
    <div class="container bleed bleed--right">
      <div class="bleed__text">
        <h2 class="fr-h2">Freunde des Landesblasorchesters</h2>
        <p class="fr-text fr-text--lead">
          Ehemalige und aktive Musiker, Konzertbesucher, Freunde und Gönner unterstützen die kulturelle
          Arbeit des LBO und die Weiterentwicklung des Kulturgutes sinfonische Blasmusik – ideell und
          materiell.
        </p>
        <a class="btn btn--light" href={url('/foerderverein')}>Förderverein</a>
      </div>
      <figure class="bleed__photo">
        <Image src={registerKlarinetten} alt="Klarinettenregister des Landesblasorchesters" widths={[700, 1100, 1600, 2000]} sizes="(min-width: 900px) 58vw, 100vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ============ FÖRDERER ============ -->
  <section class="section section--tight">
    <div class="container funders">
      <h2 class="funders__title">Gefördert von</h2>
      <div class="funders__logos">
        <Image class="funders__logo funders__logo--wide" src={logoBvbw} alt="Blasmusikverband Baden-Württemberg" widths={[240, 480]} sizes="220px" loading="lazy" />
        <Image class="funders__logo funders__logo--tall" src={logoLmv} alt="Landesmusikverband Baden-Württemberg e.V." widths={[220, 440]} sizes="110px" loading="lazy" />
        <Image class="funders__logo" src={logoFreunde} alt="Freunde des Landesblasorchesters Baden-Württemberg" widths={[240, 480, 720]} sizes="240px" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============ KONTAKT (Plakat-Fuß) ============ -->
  <section class="red red--closing">
    <svg class="red__edge" viewBox="0 0 1600 200" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
      <path class="red__fill" d="M0 150c250 0 330-100 580-100 240 0 300 96 540 96 220 0 290-70 480-70V200H0Z" />
    </svg>
    <div class="container red__inner red__inner--cta">
      <h2 class="fr-h2 fr-h2--statement">Ob Galakonzert, Mitgliedschaft oder Lehrangebot – sprechen Sie uns an.</h2>
      <a class="btn btn--paper" href={url('/kontakt')}>Kontakt aufnehmen</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     Typografie der Startseite
     Überschriften Semibold, Fließtext Light (CD Manual S. 22)
     ============================================================ */
  .fr-h2 {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.75rem);
    font-size: clamp(2rem, 1.4rem + 2.1vw, 3.25rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: var(--red);
    max-width: 22ch;
  }
  .fr-h2--statement {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem);
    line-height: 1.12;
    max-width: 26ch;
  }
  .fr-text {
    margin: 0 0 1.1em;
    max-width: 60ch;
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.15rem);
    line-height: 1.62;
    color: var(--ink-2);
  }
  .fr-text--lead { font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem); line-height: 1.5; color: var(--ink); }

  .fr-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.75rem, 3vw, 2.5rem); }

  .fr-head {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .fr-head .fr-h2, .fr-head .fr-text { margin-bottom: 0; }

  /* Textlink ohne angehängten Pfeil: Unterstreichung trägt die Bedeutung */
  .fr-link {
    display: inline-block;
    padding-block: 0.2rem;
    font-weight: 600;
    color: var(--red);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--red-light);
    transition: color .25s var(--ease), text-decoration-color .25s var(--ease);
  }

  /* Freistehende Links unter dem Text färben sich beim Mouseover auf.
     „Weiterlesen" hatte bisher gar keine Rückmeldung. */
  .fr-link:hover,
  .paths__title a:hover,
  .news :global(.ncard__link:hover .ncard__more) {
    color: var(--red-hover);
    text-decoration-color: var(--red-hover);
  }

  /* Knöpfe in Satzschreibung statt gesperrter Versalien */
  /* main liegt im Layout, nicht in dieser Datei – daher global (lädt nur hier).
     Der Kopf behält seine Knöpfe unverändert. */
  :global(main section:not(.hero) .btn) {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    padding: 0.8em 1.5em;
  }
  .btn--paper { --btn-bg: #fff; --btn-fg: var(--red); --btn-bd: #fff; }
  /* wie .btn--light: Rot hell mit dunkler Schrift – Wechsel 3,45:1, Text 5,3:1 */
  .btn--paper:hover { --btn-bg: var(--red-light); --btn-fg: var(--dark); --btn-bd: var(--red-light); }

  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #100e0b;
    color: #fff;
  }
  .hero__media { position: absolute; inset: 0; }
  .hero__media :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center 42%;
    animation: heroZoom 26s var(--ease) forwards;
  }
  @keyframes heroZoom {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img) { animation: none; }
  }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(16,14,11,.92) 0%, rgba(16,14,11,.78) 26%, rgba(16,14,11,.42) 52%, rgba(16,14,11,.14) 74%, rgba(16,14,11,.46) 100%),
      linear-gradient(to right, rgba(16,14,11,.55) 0%, rgba(16,14,11,.18) 46%, rgba(16,14,11,0) 72%);
  }

  .hero__inner {
    position: relative;
    padding-bottom: clamp(6rem, 14vh, 10rem);
    padding-top: 10rem;
  }

  .hero__claim {
    margin: 0;
    font-size: clamp(2.6rem, 1rem + 7.2vw, 6.4rem);
    font-weight: 250;
    line-height: 0.99;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .hero__claim span {
    display: block;
    opacity: 0;
    transform: translateY(22px);
    animation: heroIn 1s var(--ease) forwards;
  }
  .hero__claim span:nth-child(1) { animation-delay: .15s; }
  .hero__claim span:nth-child(2) { animation-delay: .3s; }

  .hero__sub {
    margin: 1.6rem 0 0;
    font-size: clamp(1rem, 0.92rem + 0.5vw, 1.28rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.88);
    max-width: 52ch;
    opacity: 0; transform: translateY(16px);
    animation: heroIn .9s var(--ease) .48s forwards;
  }

  .hero__actions {
    display: flex; flex-wrap: wrap; gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    opacity: 0; transform: translateY(16px);
    animation: heroIn .9s var(--ease) .62s forwards;
  }

  @keyframes heroIn { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__claim span, .hero__sub, .hero__actions { opacity: 1; transform: none; animation: none; }
  }

  /* ============================================================
     Konzerte – gesetzt wie eine Tourneeliste
     ============================================================ */
  .dates {
    display: grid;
    gap: clamp(2rem, 3.5vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0; padding: 0; list-style: none;
  }
  .dates__when { margin: 0 0 1rem; }
  .dates__when time { display: block; }
  .dates__day {
    display: block;
    font-size: clamp(3.5rem, 2.6rem + 3vw, 5.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }
  .dates__month {
    display: block;
    margin-top: 0.6rem;
    font-size: 1.05rem; font-weight: 600;
    color: var(--ink);
  }
  .dates__weekday { display: block; font-size: 1rem; color: var(--ink-3); }
  .dates__place {
    margin: 0 0 0.35rem;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .dates__title { margin: 0 0 0.6rem; line-height: 1.45; color: var(--ink-2); }
  .dates__details { margin: 0; padding: 0; list-style: none; font-size: 0.95rem; line-height: 1.5; color: var(--ink-3); }
  /* Schmal: Tag und Monat auf eine Zeile, damit die Liste nicht ausufert */
  @media (max-width: 599px) {
    .dates { gap: 2.25rem; }
    .dates__when { margin-bottom: 0.6rem; }
    .dates__when time { display: flex; align-items: baseline; gap: 0.6rem; }
    .dates__day { font-size: 3rem; }
    .dates__month { margin-top: 0; }
  }

  /* ============================================================
     ECWO
     ============================================================ */
  .ecwo { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
