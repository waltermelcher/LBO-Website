---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Seite nicht gefunden" description="Die aufgerufene Seite existiert nicht.">
  <section class="nf">
    <div class="container">
      <span class="eyebrow">Fehler 404</span>
      <h1 class="h1 nf__title">Diese Seite haben wir nicht im Repertoire.</h1>
      <p class="lead nf__lead">
        Der aufgerufene Link existiert nicht oder wurde verschoben. Vielleicht finden Sie hier, was Sie
        suchen:
      </p>
      <div class="nf__actions">
        <a class="btn" href={url('/')}>Zur Startseite</a>
        <a class="btn btn--ghost" href={url('/konzerttermine')}>Konzerttermine</a>
        <a class="btn btn--ghost" href={url('/kontakt')}>Kontakt</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(10rem, 20vw, 16rem) clamp(5rem, 10vw, 9rem); }
  .nf__title { max-width: 18ch; }
  .nf__lead { margin-top: 1.5rem; max-width: 46ch; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.5rem; }
</style>
