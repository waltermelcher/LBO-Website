---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import { url } from '../utils';
import probe from '../assets/img/lbo-probe.jpg';
import registerHolz from '../assets/img/register-holz.jpg';

const questions = [
  'Welches Werk fördert unseren Orchesterklang?',
  'Wie grooven Polkas, Märsche und Walzer richtig?',
  'Wie bringt man die Klangfarben eines Blasorchesters zur Geltung?',
  'Wie setzt man Artikulation, Phrasierung und Dynamik stilecht ein?',
  'Welches Stück passt in unser neues Konzertprogramm?',
];

const concept = [
  'Als teilnehmendes Orchester wählt Ihr ein Werk aus unseren Klassiker-Listen aus. Im Idealfall bereitet Ihr dieses Stück bereits mit Eurem Orchester vor.',
  'Beim einstündigen Lehrkonzert proben die MusikerInnen Eures Orchesters gemeinsam mit denen des LBO am ausgewählten Werk. Der künstlerische Leiter Björn Bus gibt dabei nicht nur Probetipps für kniffelige Stellen, sondern geht auch auf die Hintergründe und Interpretationsansätze des Werkes ein.',
  'Die LBO-MusikerInnen geben Euren KollegInnen aus den Musikvereinen wichtige Hinweise für die Bewältigung der einzelnen Stimmen.',
  'Durch das gemeinsame Musizieren lernt man sich gegenseitig kennen und baut mögliche Berührungsängste ab. Letztlich werden beide Seiten, Musikverein sowie Landesblasorchester, von dieser Begegnung musikalisch und menschlich profitieren.',
  'Das gemeinsam erprobte Stück könnte z. B. Teil Eures kommenden Konzertprogrammes werden.',
];

const symphonic = [
  'Sayonara – Jan van der Roost',
  'Flashing Winds – Jan van der Roost',
  'Gulliver’s Travels – Bert Appermont',
  'Lord Tullamore – Carl Wittrock',
  'Alvamar Overture – James Barnes',
  'English Folk Song Suite – Ralph Vaughan Williams',
  'First Suite – Gustav Holst',
  'October – Eric Whitacre',
  'Oregon – Jacob de Haan',
  'Armenian Dances (Part 1) – Alfred Reed',
  'The Lord of the Rings (Gandalf & Hobbits) – Johan de Meij',
];

const traditional = [
  {
    group: 'Märsche',
    items: [
      'Arsenal – Jan van der Roost',
      'Die Sonne geht auf – Rudi Fischer',
      'Florentiner Marsch – Julius Fučik',
      'Mars der Medici – Johan Wichers',
      'Mit vollen Segeln – Klaus Strobl',
    ],
  },
  {
    group: 'Polkas',
    items: [
      'Auf der Vogelwiese – Josef Poncar',
      'Böhmischer Traum – Norbert Gälle',
      'Von Freund zu Freund – Martin Scharnagl',
    ],
  },
  {
    group: 'Walzer',
    items: [
      'An der schönen blauen Donau – Johann Strauß (Sohn)',
      'Waltz No. 2 – Dimitri Schostakowitsch',
    ],
  },
];
---

<BaseLayout
  title="Lehrkonzert"
  description="Das LBO-Lehrkonzert: Gemeinsam mit dem Landesblasorchester sinfonische und traditionelle Blasmusik-Klassiker entdecken."
>
  <PageHeader
    eyebrow="Orchester"
    title="Lehrkonzert"
    lead="Gemeinsam sinfonische und traditionelle Blasmusik-Klassiker entdecken."
  />

  <section class="section section--tight">
    <div class="container">
      <div class="split split--even qgrid">
        <div class="reveal">
          <ul class="questions">
            {questions.map((q) => <li>{q}</li>)}
          </ul>
          <p class="qgrid__answer">Probiert es doch mal mit dem LBO-Lehrkonzert!</p>
          <p class="qgrid__note">
            Die Lehrkonzerte finden in der Regel jeweils vor den abendlichen Konzerten des Landesblasorchesters
            statt.
          </p>
          <a class="btn" href={url('/konzerttermine')}>
            Lehrkonzert-Termine
            <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
              <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
        <figure class="figure figure--zoom qgrid__figure reveal" data-delay="1">
          <Image src={probe} alt="Probe des Landesblasorchesters" widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container">
      <SectionHead eyebrow="Konzept" title="Ablauf des Lehrkonzerts" />
      <div class="sbody">
        <div class="prose reveal">
          {concept.map((p) => <p>{p}</p>)}

          <h2>Warum Klassiker der sinfonischen Blasmusik?</h2>
          <p>
            Geht man in ein Sinfonieorchester-Konzert, so hört man ganz oft die bekannten Klassiker von Mozart,
            Haydn oder Beethoven. Doch es gibt auch für Blasorchester zahlreiche Klassiker, die mitreißend und
            wichtig für die Klangentwicklung der sinfonischen Blasorchester sind. Wir haben elf Werke
            unterschiedlicher Schwierigkeitsgrade ausgewählt, die allesamt von sehr hoher künstlerischer
            Qualität und in jeglicher Hinsicht begeisternd sind.
          </p>

          <h2>Warum Klassiker der traditionellen Blasmusik?</h2>
          <p>
            Die traditionelle Blasmusik ist ein zentraler und mit Begeisterung gelebter Bestandteil unserer
            Kultur in Baden-Württemberg, Deutschland und Europa. Polkas, Märsche und Walzer gehören zum festen
            Repertoire unserer Musikvereine im Land. Die Werke der traditionellen Blasmusik bergen stilistische
            Feinheiten auf engstem Raum, die es gemeinsam zu gestalten gilt. Wir haben zehn Werke aus dem
            Bereich der traditionellen Blasmusik ausgewählt, die aus dem heutigen Repertoire nicht mehr
            wegzudenken sind.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Repertoirelisten -->
  <section class="section">
    <div class="container">
      <div class="repertoire">
        <div>
          <h2 class="h3 rep__head reveal">Klassiker der sinfonischen Blasmusik</h2>
          <ul class="rep reveal">
            {symphonic.map((w) => <li class="rep__item">{w}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="h3 rep__head reveal" data-delay="1">Klassiker der traditionellen Blasmusik</h2>
          {traditional.map((g, i) => (
            <div class="rep__group reveal" data-delay={String(Math.min(i + 1, 4))}>
              <h3 class="rep__sub">{g.group}</h3>
              <ul class="rep">
                {g.items.map((w) => <li class="rep__item">{w}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Teilnahme -->
  <section class="section section--dark">
    <div class="container">
      <div class="split split--even join">
        <div class="reveal">
          <span class="eyebrow">Als Musikverein teilnehmen</span>
          <h2 class="h2">Ein Lehrkonzert mit dem LBO veranstalten</h2>
          <p class="lead">
            Falls Sie gemeinsam mit Ihrem Musikverein und dem LBO ein Lehrkonzert veranstalten möchten, dann
            freuen wir uns sehr über eine Kontaktaufnahme.
          </p>
          <a class="btn btn--light" href={url('/kontakt')}>
            Kontakt aufnehmen
            <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
              <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
        <figure class="figure figure--zoom join__figure reveal" data-delay="1">
          <Image src={registerHolz} alt="Holzbläser des Landesblasorchesters" widths={[600, 1000, 1600]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="next reveal">
        <div>
          <span class="eyebrow">Next Step</span>
          <h2 class="h3">Die LBO-Akademie „hautnah“</h2>
          <p class="next__text">
            Hat Dir das Lehrkonzert gefallen? Bist Du bereit für den nächsten Schritt? Schau dem Orchester bei
            der Erarbeitung seines Konzertprogramms über die Schulter oder nimm aktiv an den Proben teil.
          </p>
        </div>
        <a class="btn btn--ghost" href={url('/lbo-hautnah')}>
          LBO-hautnah
          <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .qgrid { align-items: center; }
  .qgrid__figure { aspect-ratio: 4 / 3; }
  .questions { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .questions li:hover { background: var(--accent-wash); }
  .questions li {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.05rem, 0.98rem + 0.5vw, 1.28rem);
    font-weight: 300; letter-spacing: -0.016em; line-height: 1.35;
  }
  .qgrid__answer {
    margin: 1.9rem 0 0;
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.85rem);
    font-weight: 300; letter-spacing: -0.026em; color: var(--accent);
    max-width: 20ch;
  }
  .qgrid__note { margin: 1.2rem 0 2rem; color: var(--ink-2); max-width: 46ch; }

  .repertoire { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 860px) { .repertoire { grid-template-columns: 1fr 1fr; } }
  .rep__head { margin-bottom: 1.4rem; }
  .rep__sub {
    margin: 0 0 0.9rem;
    font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--accent);
  }
  .rep__group + .rep__group { margin-top: 2.2rem; }
  .rep { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .rep__item:hover { background: var(--accent-wash); }
  .rep__item {
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.98rem; font-weight: 300; color: var(--ink-2);
  }

  .join { align-items: center; }
  .join__figure { aspect-ratio: 4 / 3; }
  .join .lead { margin-block: 1.4rem 2.1rem; }

  .next {
    display: flex; flex-wrap: wrap; align-items: end;
    justify-content: space-between; gap: 1.5rem 2.5rem;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .next__text { margin: 0.8rem 0 0; max-width: 52ch; color: var(--ink-2); }
</style>
