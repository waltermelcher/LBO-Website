---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import logoFreunde from '../assets/logos/freunde-lbo.png';
import registerTuben from '../assets/img/register-tuben.jpg';

const JOIN = 'mailto:geschaeftsfuehrer@freunde-des-lbo.de?subject=Mitgliedschaft%20Freunde%20des%20LBO';

const privateTiers = [
  { name: 'Standard', price: '50', benefits: ['Informationen via E-Mail'] },
  {
    name: 'Silber',
    price: '150',
    benefits: ['Informationen via E-Mail', 'Zwei Freikarten für Wunschkonzerte', 'Auf Wunsch Nennung auf Homepage'],
  },
  {
    name: 'Gold',
    price: '500',
    benefits: [
      'Informationen via E-Mail',
      'Vier Freikarten für Wunschkonzerte',
      'Auf Wunsch Nennung auf Homepage',
      'Auf Wunsch Nennung in Programmheft',
      'Überraschungsbox',
    ],
  },
  {
    name: 'Platin',
    price: '1500',
    benefits: [
      'Informationen via E-Mail',
      'Freier Eintritt für zwei Personen zu allen LBO-Konzerten',
      'Auf Wunsch Nennung auf Homepage',
      'Auf Wunsch Nennung in Programmheft',
      'Überraschungsbox',
      'Exklusiver Empfang mit Vorstand und Dirigent (1×/Jahr)',
    ],
  },
];

const companyTiers = [
  { name: 'Standard', price: '100', benefits: ['Informationen via E-Mail'] },
  {
    name: 'Silber',
    price: '500',
    benefits: ['Informationen via E-Mail', 'Zwei Freikarten für Wunschkonzerte', 'Auf Wunsch Nennung mit Logo auf Homepage'],
  },
  {
    name: 'Gold',
    price: '1500',
    benefits: [
      'Informationen via E-Mail',
      'Vier Freikarten für Wunschkonzerte',
      'Auf Wunsch Nennung mit Logo auf Homepage',
      'Auf Wunsch Nennung mit Logo in Programmheft',
      'Überraschungsbox',
    ],
  },
  {
    name: 'Platin',
    price: '5000',
    benefits: [
      'Informationen via E-Mail',
      'Freier Eintritt für zwei Personen zu allen LBO-Konzerten',
      'Auf Wunsch Nennung mit Logo auf Homepage',
      'Auf Wunsch Nennung mit Logo in Programmheft',
      'Überraschungsbox',
      'Exklusiver Empfang mit Vorstand und Dirigent (1×/Jahr)',
    ],
  },
];

const board = [
  { role: 'Vorsitzender', name: 'Roland Ströhm', mail: 'vorsitzender@freunde-des-lbo.de' },
  { role: 'Geschäftsführerin', name: 'Stefanie Wunder', mail: 'geschaeftsfuehrer@freunde-des-lbo.de' },
  { role: 'Kassier', name: 'Helmut Schwarz', mail: 'kassier@freunde-des-lbo.de' },
  { role: 'Schriftführerin', name: 'Ingrid Gökeler', mail: 'schriftfuehrer@freunde-des-lbo.de' },
  { role: 'Mit beratender Stimme als Vertreter des LBO', name: 'Erich Hermann', mail: 'erich.hermann@freunde-des-lbo.de' },
];
---

<BaseLayout
  title="Förderverein"
  description="Die Freunde des Landesblasorchesters Baden-Württemberg fördern die kulturelle Arbeit des LBO ideell und materiell."
  bodyClass="theme-blue"
>
  <PageHeader
    title="Freunde des Landesblasorchesters"
    lead="Ein gemeinnütziger Verein für die Weiterentwicklung des Kulturgutes sinfonische Blasmusik."
    image={registerTuben}
    imageAlt="Tiefes Blech des Landesblasorchesters"
  />

  <section class="section">
    <div class="container">
      <div class="split split--label">
        <div class="reveal">
          <figure class="brandmark">
            <Image src={logoFreunde} alt="Freunde des Landesblasorchesters Baden-Württemberg" widths={[300, 600]} sizes="240px" loading="lazy" />
          </figure>
        </div>
        <div class="prose reveal" data-delay="1">
          <p>
            Das Landesblasorchester Baden-Württemberg ist das musikalische Aushängeschild des Blasmusikverbandes
            Baden-Württemberg e.V. mit seinen besonderen künstlerischen und kulturpolitischen Aufgaben und
            seinem bedeutsamen Alleinstellungsmerkmal. Dieser Klangkörper zeigt mit seiner beeindruckenden
            Entwicklung die gewachsenen Potenziale der Blasmusikkultur in Baden-Württemberg auf.
          </p>
          <p>
            Durch die Zusammenarbeit mit international renommierten Dirigentinnen und Dirigenten, Komponisten
            und Solisten, durch eine kreative, ambitionierte und wegweisende Programmgestaltung und nicht
            zuletzt durch die unzähligen Konzerte im In- und Ausland, verfügt Baden-Württemberg über einen
            Kulturbotschafter von besonderer Güte. Als Botschafter der sinfonischen Blasmusik vergibt das LBO
            Kompositionsaufträge, veröffentlicht neue Werke durch Ur- oder Erstaufführungen und produziert
            Tonträger-Einspielungen, die als Klangreferenz dienen.
          </p>
          <p>
            Das LBO kommt im Rahmen verschiedener Lehrformate seinem Auftrag zur Basis- und Bildungsarbeit mit
            Musikern und Dirigenten nach. Den einzelnen LBO-Mitgliedern kommt durch die Weitergabe ihrer
            Erfahrungen und Motivation im LBO in ihren Heimatvereinen und Organisationen eine
            Multiplikatorenfunktion zu.
          </p>
          <p>
            Besonders bemerkenswert und beispielhaft für den Orchesterbetrieb des LBO ist das Zusammenfinden
            von professionellem Denken und Handeln in ehrenamtliche Strukturen.
          </p>
          <p>
            Ehemalige und aktive Musiker des LBO, Konzert- und Workshop-Besucher sowie weitere Freunde und
            Gönner des LBO haben sich zu dem gemeinnützigen Verein „Freunde des Landesblasorchester
            Baden-Württemberg“, welcher am 25. Oktober 2018 gegründet wurde, zusammengeschlossen und möchten
            die wichtige kulturelle Arbeit des LBO, die Weiterentwicklung des Kulturgutes Sinfonische
            Blasmusik, fördern und mit ideellen und materiellen Hilfen unterstützen.
          </p>
          <p>Wir bedanken uns für Ihr Interesse und freuen uns, Sie hoffentlich bald begrüßen zu dürfen!</p>
          <p>
            Bei Fragen wenden Sie sich sehr gerne per E-Mail an unsere Geschäftsführerin{' '}
            <a href="mailto:geschaeftsfuehrer@freunde-des-lbo.de">Stefanie Wunder</a>.
          </p>
          <p><a class="btn" href={JOIN}>Mitglied werden
            <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
              <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mitgliedschaften Privat -->
  <section class="section section--deep">
    <div class="container">
      <SectionHead title="Mitgliedschaft für Privatpersonen" />
      <div class="tiers">
        {privateTiers.map((t, i) => (
          <div class:list={['tier', 'reveal', t.name === 'Gold' && 'tier--accent']} data-delay={String(Math.min(i, 3))}>
            <h3 class="tier__name">{t.name}</h3>
            <p class="tier__price"><span class="tier__cur">€</span>{t.price}<span class="tier__per">/Jahr</span></p>
            <ul class="tier__list">
              {t.benefits.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="tier__note reveal">
        Die Standard-Mitgliedschaft für Schüler und Studenten wird für 20 € / Jahr angeboten. Eine
        Paar-Mitgliedschaft wird ab Silber-Level angeboten.
      </p>
      <p class="reveal"><a class="btn" href={JOIN}>Mitglied werden
        <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
          <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
        </svg></a></p>
    </div>
  </section>

  <!-- Mitgliedschaften Firmen -->
  <section class="section">
    <div class="container">
      <SectionHead title="Mitgliedschaft für Firmen und Institutionen" />
      <div class="tiers">
        {companyTiers.map((t, i) => (
          <div class:list={['tier', 'reveal', t.name === 'Gold' && 'tier--accent']} data-delay={String(Math.min(i, 3))}>
            <h3 class="tier__name">{t.name}</h3>
            <p class="tier__price"><span class="tier__cur">€</span>{t.price}<span class="tier__per">/Jahr</span></p>
            <ul class="tier__list">
              {t.benefits.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="reveal tier__cta"><a class="btn" href={JOIN}>Mitglied werden
        <svg class="arw" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
          <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
        </svg></a></p>
    </div>
  </section>

  <!-- Vorstandschaft -->
  <section class="section section--dark">
    <div class="container">
      <SectionHead title="Vorstandschaft" />
      <div class="sbody">
        <div>
          <ul class="fboard">
            {board.map((m, i) => (
              <li class="fboard__item reveal" data-delay={String(Math.min(i, 4))}>
                <span class="fboard__role">{m.role}</span>
                <a class="fboard__name" href={`mailto:${m.mail}`}>{m.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Dank & Downloads -->
  <section class="section">
    <div class="container">
      <SectionHead
        size="md"
        title="Wir danken allen Mitgliedern, die uns dabei helfen, unsere Förderzwecke zu erfüllen, herzlich!"
      />
      <div class="sbody">
        <div class="reveal">
          <p class="thanks__text">
            Ein besonderer Dank gilt den Silber-, Gold- und Platinmitgliedern des Fördervereins:
          </p>
          <p class="thanks__names">Ilka und Erich Hermann</p>

          <h3 class="thanks__sub">Weitere Informationen</h3>
          <ul class="docs">
            <li><a href="mailto:geschaeftsfuehrer@freunde-des-lbo.de?subject=Satzung">Satzung anfragen</a></li>
            <li><a href="mailto:geschaeftsfuehrer@freunde-des-lbo.de?subject=Datenschutzordnung">Datenschutzordnung anfragen</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .brandmark { margin: 0; width: clamp(160px, 20vw, 240px); }

  .tiers {
    display: grid; gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .tier {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex; flex-direction: column;
  }
  :global(.section--deep) .tier { background: var(--bg-deep); }
  .tier--accent { background: var(--bg-soft) !important; box-shadow: inset 0 0 0 1px var(--line-accent); }

  .tier__name {
    margin: 0;
    font-size: 1.15rem; font-weight: 500;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .tier__price {
    margin: 0.7rem 0 1.5rem;
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem);
    font-weight: 250; letter-spacing: -0.035em; line-height: 1;
  }
  .tier__cur { font-size: 0.55em; vertical-align: 0.35em; margin-right: 0.08em; }
  .tier__per { font-size: 0.36em; letter-spacing: 0.02em; color: var(--ink-3); }

  .tier__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-soft); }
  .tier__list li {
    padding: 0.62rem 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.88rem; color: var(--ink-2); line-height: 1.4;
  }
  .tier__note { margin: 1.75rem 0 2rem; font-size: 0.88rem; color: var(--ink-3); max-width: 62ch; }
  .tier__cta { margin-top: 2rem; }

  .fboard { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-dark); }
  .fboard__item:hover { background: color-mix(in srgb, var(--accent-light) 12%, transparent); }
  .fboard__item {
    display: grid; gap: 0.3rem 2.5rem;
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    border-bottom: 1px solid var(--line-dark);
  }
  @media (min-width: 640px) { .fboard__item { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); align-items: baseline; } }
  .fboard__role { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(243,237,227,.5); }
  .fboard__name {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.45rem);
    font-weight: 300; letter-spacing: -0.02em; color: var(--on-dark);
    transition: color .25s var(--ease);
  }
  .fboard__name:hover { color: var(--accent-light); }

  .thanks__head { max-width: 40ch; }
  .thanks__text { margin: 1.4rem 0 0.6rem; color: var(--ink-2); }
  .thanks__names { margin: 0; font-size: 1.15rem; font-weight: 400; color: var(--accent); }
  .thanks__sub {
    margin: 2.75rem 0 1rem;
    font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3);
  }
  .docs { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .docs li { border-bottom: 1px solid var(--line); }
  .docs a {
    display: block; padding: 0.85rem 0;
    color: var(--ink-2);
    transition: color .25s var(--ease), padding-left .3s var(--ease);
  }
  .docs a:hover { color: var(--accent); padding-left: 0.5rem; }
</style>
